.{
    .id = "com.zig-nostr.plaza",
    .name = "plaza",
    .display_name = "Plaza",
    .description = "A fast, local-first Nostr client, built natively in Zig.",
    .version = "0.4.0",
    .icons = .{"assets/icon.png"},
    .platforms = .{"macos"},
    .permissions = .{ "view", "command", "clipboard" },
    .capabilities = .{ "native_views", "gpu_surfaces" },
    .shell = .{
        .windows = .{
            .{
                .label = "main",
                .title = "Plaza",
                .width = 760,
                .height = 760,
                // The floor the window itself enforces (macOS contentMinSize).
                // 687 is what the layout measures: the 56pt rail, the 620pt
                // reading column, and the 11pt scrollbar gutter the virtualList
                // reserves. This is 700 for a little slack. `zig build test`
                // sweeps every screen from exactly this number and fails if the
                // content outgrows it, which is what stopped being true when the
                // feed became a virtualList and nothing moved the floor.
                .min_width = 700,
                .min_height = 680,
                .restore_state = false,
                .restore_policy = "center_on_primary",
                .views = .{
                    .{ .label = "main-canvas", .kind = "gpu_surface", .fill = true, .role = "Plaza canvas", .accessibility_label = "Plaza", .gpu_backend = "metal", .gpu_pixel_format = "bgra8_unorm", .gpu_present_mode = "timer", .gpu_alpha_mode = "opaque", .gpu_color_space = "srgb", .gpu_vsync = true },
                },
            },
        },
    },
    .security = .{
        .navigation = .{
            .allowed_origins = .{ "zero://app", "zero://inline" },
            .external_links = .{ .action = "deny" },
        },
    },
    .web_engine = "system",
    .cef = .{ .dir = "third_party/cef/macos", .auto_install = false },
    // Only the two with no in-canvas equivalent.
    //
    // Cmd+Enter and Escape are NOT declared, deliberately: a declared shortcut
    // is swallowed by the shell's key monitor before the responder chain, so
    // declaring them would take Cmd+Enter away from every multi-line field's
    // own submit (the SDK's convention for a textarea, which the nsec, bunker,
    // name and proxy fields all rely on) and Escape away from every surface's
    // `on_dismiss`, which already knows the layer order. The composer gets both
    // behaviours from the field and the sheet it is made of.
    .shortcuts = .{
        .{ .id = "new-note", .key = "n", .modifiers = .{"primary"} },
        .{ .id = "settings", .key = ",", .modifiers = .{"primary"} },
    },
}
