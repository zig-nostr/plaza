.{
    .name = .plaza,
    .fingerprint = 0xe8703ecc5a707070,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The Native SDK framework, pinned to the tree matching the `native`
        // CLI (0.9.2 -> commit 8d0da34e). `native eject` writes a machine-local
        // `.path` into the npm install here; this git pin is committable and
        // reproducible instead, CI fetches the exact framework by hash.
        //
        // Bump this and the CLI version in .github/workflows/ci.yml IN THE SAME
        // COMMIT. The automation harness refuses to read a snapshot when the
        // CLI and the framework speak different protocol versions, and moving
        // one alone does not fail the build: it silently breaks every live test.
        //
        // A fork rather than vercel-labs/native, for one patch: the renderer
        // Linux presents with inks every glyph from one face and stops at
        // U+FFFF, so an emoji is a solid block there and no app can fix it from
        // above. The fork reads cmap format 12 and COLR/CPAL, which is what
        // lets a registered colour face draw real emoji. It is 8d0da34 plus
        // that one commit and nothing else, so the emoji fix stays separable
        // from an SDK upgrade. Filed upstream as vercel-labs/native#421; when
        // it lands this goes back to vercel-labs/native and the fork is
        // deleted. See PATCHES.md in the fork.
        .native_sdk = .{
            .url = "git+https://github.com/zig-nostr/native.git#5889503d7e436ba209ab237e510ffca7e46158d7",
            .hash = "native_sdk-0.1.0-hzDzQtlkqQIkX_hTI_Udj05p5c058Sc0VkoDC2CQADZw",
        },
        // The zig-nostr protocol library, linked directly into this app process
        // (it vendors secp256k1 + LMDB). Plaza opens the local store in the
        // render process for zero-copy feed reads, the one-process architecture.
        .nostr = .{
            .url = "https://github.com/zig-nostr/nostr/archive/refs/tags/v0.13.0.tar.gz",
            .hash = "nostr-0.13.0-CMyPzUCBCAD4Mu6AbQ68zO0srXwxNnNKZkWq9BiJOyjt",
        },
    },
    .paths = .{ "build.zig", "build.zig.zon", "src", "assets", "app.zon" },
}
