<!-- The join screen: create a fresh identity, or sign in with an existing
     nsec or a bunker link. Reached voluntarily (a gated verb, the guest
     strip, the Guest chip), never as a wall, so it always offers the way
     back to reading. Compiled into the Zig view (see `onboardingView` in
     src/main.zig). Validate: native check -->
<column gap="16" main="center" cross="center" grow="1" padding="32">
  <text size="display">Plaza</text>
  <text size="heading">Welcome to Nostr</text>
  <text wrap="true" foreground="text_muted">{welcome_lead}</text>
  <button size="lg" variant="primary" disabled="{no_keyholder}" on-press="create_identity">Create your identity</button>
  <text size="sm" wrap="true" foreground="text_muted">{create_hint}</text>
  <separator/>
  <text size="sm" wrap="true" foreground="text_muted">Already on Nostr? Paste your nsec to bring your key, or a bunker link to sign with your own signer and keep the key off this device.</text>
  <input-group width="340">
    <textarea text="{login_draft}" placeholder="bunker://…" on-input="login_edit" on-submit="login_submit"/>
    <input-group-actions>
      <text size="sm" foreground="text_muted">{login_status}</text>
      <spacer grow="1"/>
      <button size="sm" disabled="{login_empty}" on-press="login_submit">Continue</button>
    </input-group-actions>
  </input-group>
  <button size="sm" variant="ghost" on-press="keep_browsing">Keep browsing</button>
  <text size="sm" foreground="text_muted">Reading never needs an identity.</text>
</column>
